# Logging configuration
# Levels: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
LOG_MAX_FILE_SIZE_MB=50
LOG_QUEUE_CAPACITY=50000

# MT5 Bridge execution (required when an exchange uses MT5)
MT5_BRIDGE_ROOM_ID_A=OCTBridge_A
MT5_BRIDGE_ACCOUNT_A=0
MT5_BRIDGE_SYMBOL_A=
MT5_BRIDGE_VOLUME_A=0
MT5_BRIDGE_ROOM_ID_B=OCTBridge_B
MT5_BRIDGE_ACCOUNT_B=0
MT5_BRIDGE_SYMBOL_B=
MT5_BRIDGE_VOLUME_B=0
MT5_BRIDGE_ACK_TIMEOUT_MS=1000
MT5_BRIDGE_EXECUTION_TIMEOUT_MS=15000
MT5_BRIDGE_HEARTBEAT_TIMEOUT_MS=2000
