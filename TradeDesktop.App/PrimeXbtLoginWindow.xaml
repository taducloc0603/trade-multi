<Window x:Class="TradeDesktop.App.PrimeXbtLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Đăng nhập PrimeXBT"
        Width="1100"
        Height="800"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8" Background="#F2F4F7" BorderBrush="#D0D5DD" BorderThickness="0,0,0,1">
            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap"
                       Foreground="#344054"
                       Text="Đang mở trang đăng nhập PrimeXBT…" />
        </Border>
        <wv2:WebView2 x:Name="Browser" />
    </DockPanel>
</Window>
